#!/bin/bash
CSV="/var/log/kickouts.csv"
NAMES="/etc/kickout-names.txt"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

lookup_name() {
  local mac="$1"
  if [ -f "$NAMES" ]; then
    grep -i "^$mac" "$NAMES" | awk '{$1=""; print substr($0,2)}' | head -1
  fi
}

print_section() {
  local title="$1" since="$2" red_thresh="$3" yellow_thresh="$4" limit="${5:-5}"
  echo -e "${BOLD}${CYAN}${title}${NC}"

  local count
  count=$(awk -F',' -v d="$(date -u -d "$since" '+%Y-%m-%d %H:%M:%S')" \
    'NR>1 && $1 >= d {c++} END {print c+0}' "$CSV" 2>/dev/null || echo 0)

  if [ "$count" -eq 0 ]; then
    if [ -n "$log_interval" ]; then
      echo -e "  ${YELLOW}logging enabled, no drops yet${NC}"
    else
      echo -e "  ${RED}logging not configured${NC}  ${CYAN}(press c)${NC}"
    fi
    echo
    return
  fi

  awk -F',' -v d="$(date -u -d "$since" '+%Y-%m-%d %H:%M:%S')" \
    'NR>1 && $1 >= d {count[$3]++} END {for (m in count) printf "%d %s\n", count[m], m}' \
    "$CSV" | sort -nr | head -"$limit" | while read -r count mac; do
      name=$(lookup_name "$mac")
      [ -n "$name" ] && display="$mac  ($name)" || display="$mac"
      if [ "$count" -ge "$red_thresh" ]; then
        printf "  ${RED}${BOLD}%5d${NC} drops   %s\n" "$count" "$display"
      elif [ "$count" -ge "$yellow_thresh" ]; then
        printf "  ${YELLOW}${BOLD}%5d${NC} drops   %s\n" "$count" "$display"
      else
        printf "  ${GREEN}%5d${NC} drops   %s\n" "$count" "$display"
      fi
    done

  local total
  total=$(awk -F',' -v d="$(date -u -d "$since" '+%Y-%m-%d %H:%M:%S')" \
    'NR>1 && $1 >= d {macs[$3]=1} END {print length(macs)}' "$CSV" 2>/dev/null || echo 0)
  if [ "$total" -gt "$limit" ]; then
    echo -e "  ${CYAN}… and $((total - limit)) more  (press w to see all)${NC}"
  fi
  echo
}

cron=$(crontab -l 2>/dev/null || true)
has_reboot=0
echo "$cron" | grep -q "@reboot.*reapply-kickout" && has_reboot=1

get_interval() {
  echo "$cron" | grep -E "^\*/[0-9]+.*$1" | head -1 | grep -oE '\*/[0-9]+' | tr -d '*/' || true
}
fix_interval=$(get_interval "reapply-kickout")
log_interval=$(get_interval "log-kickouts")

echo -e "${CYAN}"
cat << 'ART'
 _   _       _  __ _   _  ___      _               _     _____ _                 
| | | |_ __ (_)/ _(_) | |/ (_) ___| | _____  _   _| |_  |  ___(_)_  _____ _ __ 
| | | | '_ \| | |_| | | ' /| |/ __| |/ / _ \| | | | __| | |_  | \ \/ / _ \ '__|
| |_| | | | | |  _| | | . \| | (__|   < (_) | |_| | |_  |  _| | |>  <  __/ |   
 \___/|_| |_|_|_| |_| |_|\_\_|\___|_|\_\___/ \__,_|\__| |_|   |_/_/\_\___|_|   
ART
echo -e "${NC}"

LIMIT="${1:-5}"
print_section "Drops — last 24 hours" "1 day ago" 20 5 "$LIMIT"
print_section "Drops — last 7 days" "7 days ago" 50 15 "$LIMIT"

if [ -z "$1" ]; then
  echo -ne "${BOLD}Fix:${NC}     "
  if [ "$has_reboot" -eq 1 ] && [ -n "$fix_interval" ]; then
    echo -e "${GREEN}on boot + every ${fix_interval} minutes${NC}"
  elif [ "$has_reboot" -eq 1 ]; then
    echo -e "${YELLOW}on boot only${NC}"
  elif [ -n "$fix_interval" ]; then
    echo -e "${YELLOW}every ${fix_interval} minutes only${NC}"
  else
    echo -e "${RED}not configured${NC}  ${CYAN}(press c)${NC}"
  fi

  echo -ne "${BOLD}Logging:${NC} "
  if [ -n "$log_interval" ]; then
    echo -e "${GREEN}every ${log_interval} minutes${NC}"
  else
    echo -e "${RED}not configured${NC}  ${CYAN}(press c)${NC}"
  fi
fi
