#!/bin/bash
CSV="/var/log/kickouts.csv"
CYAN='\033[0;36m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
BOLD='\033[1m'; NC='\033[0m'

show_static() {
  clear
  echo -e "${BOLD}${CYAN}Kickout query examples${NC}"
  echo
  echo -e "${YELLOW}Last 24h count by device:${NC}"
  echo "awk -F',' -v d=\"\$(date -u -d '1 day ago' '+%Y-%m-%d %H:%M:%S')\" 'NR>1 && \$1 >= d {count[\$3]++} END {for (m in count) printf \"%5d  %s\\n\", count[m], m}' $CSV | sort -nr"
  echo
  echo -e "${YELLOW}Last 7d count by device:${NC}"
  echo "awk -F',' -v d=\"\$(date -u -d '7 days ago' '+%Y-%m-%d %H:%M:%S')\" 'NR>1 && \$1 >= d {count[\$3]++} END {for (m in count) printf \"%5d  %s\\n\", count[m], m}' $CSV | sort -nr"
  echo
  echo -e "${YELLOW}Last 24h raw events:${NC}"
  echo "awk -F',' -v d=\"\$(date -u -d '1 day ago' '+%Y-%m-%d %H:%M:%S')\" 'NR>1 && \$1 >= d {print}' $CSV | sort"
  echo
  echo -e "${YELLOW}Last 7d raw events:${NC}"
  echo "awk -F',' -v d=\"\$(date -u -d '7 days ago' '+%Y-%m-%d %H:%M:%S')\" 'NR>1 && \$1 >= d {print}' $CSV | sort"
  echo
  echo -e "${YELLOW}Top devices (all time):${NC}"
  echo "awk -F',' 'NR>1 {count[\$3]++} END {for (m in count) printf \"%5d  %s\\n\", count[m], m}' $CSV | sort -nr"
  echo
}

show_menu() {
  clear
  echo -e "${BOLD}${CYAN}Kickout query examples${NC}"
  echo
  echo -e "${YELLOW}1${NC}  Last 24h count by device"
  echo -e "${YELLOW}2${NC}  Last 7d count by device"
  echo -e "${YELLOW}3${NC}  Last 24h raw events"
  echo -e "${YELLOW}4${NC}  Last 7d raw events"
  echo -e "${YELLOW}5${NC}  Top devices (all time)"
  echo -e "${YELLOW}s${NC}  Show raw examples (copy/paste style)"
  echo -e "${YELLOW}q${NC}  Quit"
  echo
}

show_menu
while true; do
  read -rp "$(echo -e "${CYAN}Select (1-5, s, or q):${NC} ")" choice
  case "$choice" in
    1)
      awk -F',' -v d="$(date -u -d '1 day ago' '+%Y-%m-%d %H:%M:%S')" \
        'NR>1 && $1 >= d {count[$3]++} END {for (m in count) printf "%5d  %s\n", count[m], m}' \
        "$CSV" | sort -nr
      ;;
    2)
      awk -F',' -v d="$(date -u -d '7 days ago' '+%Y-%m-%d %H:%M:%S')" \
        'NR>1 && $1 >= d {count[$3]++} END {for (m in count) printf "%5d  %s\n", count[m], m}' \
        "$CSV" | sort -nr
      ;;
    3)
      awk -F',' -v d="$(date -u -d '1 day ago' '+%Y-%m-%d %H:%M:%S')" \
        'NR>1 && $1 >= d {print}' "$CSV" | sort
      ;;
    4)
      awk -F',' -v d="$(date -u -d '7 days ago' '+%Y-%m-%d %H:%M:%S')" \
        'NR>1 && $1 >= d {print}' "$CSV" | sort
      ;;
    5)
      awk -F',' 'NR>1 {count[$3]++} END {for (m in count) printf "%5d  %s\n", count[m], m}' \
        "$CSV" | sort -nr
      ;;
    s|S) show_static ;;
    q|Q) break ;;
    *) echo "Invalid" ;;
  esac
  echo
  read -rp "Press Enter to continue..."
  show_menu
done